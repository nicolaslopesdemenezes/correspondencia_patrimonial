# ── CÉLULA 10 (OPCIONAL): Modo interativo — consulta avulsa ───────────────────
#
# Permite digitar uma descrição e ver a sugestão em tempo real.
# ─────────────────────────────────────────────────────────────────────────────

def sugerir_patrimonio(descricao_consulta: str, top_n: int = 3, threshold: float = 0.50):
    """
    Recebe uma descrição de bem e retorna os patrimônios mais prováveis
    dentre os não encontrados.
    """
    desc_norm = normalizar_texto(descricao_consulta)
    emb_consulta = modelo.encode([desc_norm], convert_to_numpy=True)
    sims = cosine_similarity(emb_consulta, embeddings_filtrados)[0]
    indices = np.argsort(sims)[::-1][:top_n]

    print(f"\n🔎 Consulta: \"{descricao_consulta}\"")
    print("-" * 60)
    encontrou = False
    for rank, idx in enumerate(indices, 1):
        score = sims[idx]
        if score < threshold:
            continue
        encontrou = True
        pat = base_filtrada.loc[idx, "Patrimônio"]
        desc_b = base_filtrada.loc[idx, "Descrição"]
        print(f"  #{rank} Patrimônio {pat} — Confiança: {score*100:.1f}%")
        print(f"      \"{desc_b}\"")
    if not encontrou:
        print("  ⚠️  Nenhuma correspondência acima do limiar mínimo.")
    print()

# Exemplos de uso:
sugerir_patrimonio("mesa escritório madeira em L")
sugerir_patrimonio("notebook dell core i5")
sugerir_patrimonio("televisão samsung smart 50 polegadas")
