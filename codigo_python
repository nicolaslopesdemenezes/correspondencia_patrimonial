# ── CÉLULA 4: Pré-processamento de texto ──────────────────────────────────────

import re

def normalizar_texto(texto: str) -> str:
    """Normaliza descrições: lowercase, remove pontuação excessiva,
    corrige espaços."""
    if not isinstance(texto, str):
        return ""
    texto = texto.lower().strip()
    texto = re.sub(r"[^\w\s,]", " ", texto)   # mantém vírgulas
    texto = re.sub(r"\s+", " ", texto)
    return texto

dados_base["Descrição_norm"] = dados_base["Descrição"].apply(normalizar_texto)
bens_sem_numero["Descrição_norm"] = bens_sem_numero["Descrição"].apply(normalizar_texto)

print("✅ Textos normalizados!")


# ── CÉLULA 5: Geração de embeddings semânticos ────────────────────────────────
#
# O modelo 'paraphrase-multilingual-MiniLM-L12-v2' foi escolhido por:
#   - Suporte nativo a português
#   - Leve (~120 MB) e rápido no Colab gratuito
#   - Alta qualidade para similaridade semântica
# ─────────────────────────────────────────────────────────────────────────────

print("⏳ Carregando modelo de linguagem (pode demorar na 1ª vez)...")
modelo = SentenceTransformer("paraphrase-multilingual-MiniLM-L12-v2")
print("✅ Modelo carregado!")

print("⏳ Gerando embeddings da base de dados...")
embeddings_base = modelo.encode(
    dados_base["Descrição_norm"].tolist(),
    batch_size=32,
    show_progress_bar=True,
    convert_to_numpy=True
)

print("⏳ Gerando embeddings dos bens sem número...")
embeddings_sem_numero = modelo.encode(
    bens_sem_numero["Descrição_norm"].tolist(),
    batch_size=32,
    show_progress_bar=True,
    convert_to_numpy=True
)

print("✅ Embeddings gerados!")
print(f"   Dimensão dos vetores: {embeddings_base.shape[1]}")


# ── CÉLULA 6: Filtragem — apenas patrimônios não encontrados ──────────────────
#
# Só faz sentido sugerir números que realmente estão desaparecidos.
# ─────────────────────────────────────────────────────────────────────────────

numeros_faltantes = set(patrimonios_nao_encontrados["Patrimônio"].tolist())

# Índices e embeddings apenas dos itens não encontrados
mask_faltantes = dados_base["Patrimônio"].isin(numeros_faltantes)
base_filtrada = dados_base[mask_faltantes].reset_index(drop=True)
embeddings_filtrados = embeddings_base[mask_faltantes.values]

print(f"🎯 Candidatos para matching: {len(base_filtrada)} patrimônios não encontrados")
base_filtrada


# ── CÉLULA 7: Cálculo de similaridade e geração de sugestões ─────────────────

THRESHOLD_MINIMO = 0.60   # Similaridade mínima para aceitar uma sugestão
TOP_N = 3                 # Número de sugestões por bem sem número

# Matriz de similaridade (bens_sem_numero × patrimônios_nao_encontrados)
sim_matrix = cosine_similarity(embeddings_sem_numero, embeddings_filtrados)

resultados = []

for i, row_sim in enumerate(sim_matrix):
    descricao_original = bens_sem_numero.loc[i, "Descrição"]

    # Ordena por similaridade decrescente
    indices_ordenados = np.argsort(row_sim)[::-1]

    sugestoes = []
    for rank, idx in enumerate(indices_ordenados[:TOP_N], start=1):
        score = row_sim[idx]
        if score < THRESHOLD_MINIMO:
            break
        patrimonio = base_filtrada.loc[idx, "Patrimônio"]
        descricao_base = base_filtrada.loc[idx, "Descrição"]
        sugestoes.append({
            "Rank": rank,
            "Patrimônio_Sugerido": patrimonio,
            "Similaridade": round(float(score), 4),
            "Confiança_%": f"{score * 100:.1f}%",
            "Descrição_na_Base": descricao_base,
        })

    if not sugestoes:
        sugestoes.append({
            "Rank": 1,
            "Patrimônio_Sugerido": "SEM SUGESTÃO",
            "Similaridade": 0.0,
            "Confiança_%": "0.0%",
            "Descrição_na_Base": "Nenhum patrimônio atingiu o limiar mínimo",
        })

    for s in sugestoes:
        resultados.append({
            "Bem_sem_número (Descrição)": descricao_original,
            **s
        })

df_resultados = pd.DataFrame(resultados)
print("✅ Sugestões geradas!")
print(f"\n{'='*80}")
print("RESULTADO — SUGESTÕES DE PATRIMÔNIO")
print(f"{'='*80}\n")
print(df_resultados.to_string(index=False))


